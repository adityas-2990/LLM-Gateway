# Copy to .env and adjust. The real .env is gitignored.
# These names are shared by docker-compose.yml and server/src/main/resources/application.yml.

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gateway
DB_USER=gateway
DB_PASSWORD=gateway

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Gateway
SERVER_PORT=8080

# Provider keys - leave blank until E4
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
